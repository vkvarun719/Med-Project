# Backend Environment Configuration Example
# Copy to .env and configure secrets accordingly

# Neon PostgreSQL Database Connection String
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-calm-snow-ap6t9z63-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require

# Secret API key required for Raspberry Pi station data transmission
STATION_API_KEY=clinic-secret-pi-key-2026

# Allowed CORS Origins (comma separated, or * for all)
CORS_ORIGINS=*

# Environment: development / production
ENVIRONMENT=production
