# ========================================================
# Clinic Patient Measurement System - Global Config (.env)
# ========================================================

# Neon PostgreSQL Database URI
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-calm-snow-ap6t9z63-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require

# Raspberry Pi Station API Key Authentication
STATION_API_KEY=clinic-secret-pi-key-2026

# React Frontend API Base URL (Point to your EC2 public IP or domain in production)
REACT_APP_API_BASE_URL=http://localhost:8000

# CORS Allowed Origins
CORS_ORIGINS=*

# Environment: development / production
ENVIRONMENT=production
